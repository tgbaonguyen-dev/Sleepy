{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sleepy",
  "mainBinaryName": "sleepy",
  "version": "2.0.0",
  "identifier": "dev.giabao.sleepy",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Sleepy",
        "url": "index.html",
        "width": 1060,
        "height": 760,
        "minWidth": 900,
        "minHeight": 640,
        "decorations": false,
        "visible": false,
        "center": true,
        "zoomHotkeysEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; media-src 'self'",
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "category": "Utility",
    "shortDescription": "Hẹn giờ tắt máy cho Ubuntu",
    "longDescription": "Hẹn giờ tắt máy, khởi động lại, ngủ, ngủ đông, khoá màn hình hoặc đăng xuất — theo thời gian hoặc khi máy xong việc.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1"
        ]
      }
    }
  }
}
